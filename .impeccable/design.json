      "html": "<label class=\"ds-label\">Персональная ссылка<input class=\"ds-input\" placeholder=\"Вставьте персональную ссылку\"/></label>",
      "css": ".ds-label{display:grid;gap:9px;font:13px \"Onest Variable\",sans-serif;color:var(--text,#18202e)}.ds-input{padding:14px 16px;border:1px solid var(--line,#dce0e8);border-radius:12px;background:var(--bg,#f5f6f8);color:var(--text,#18202e);font:15px \"Onest Variable\",sans-serif;caret-color:var(--accent,#1759e8)}.ds-input::placeholder{color:var(--muted,#626b7c)}.ds-input:hover{border-color:#a7b4ca}.ds-input:focus-visible{outline:none;border-color:var(--accent,#1759e8);box-shadow:0 0 0 3px #1759e81a}"
