      "css": ".ds-nav{padding:14px 16px;background:#e0e9fc;color:#124cc4;border:0;border-radius:12px;font:14px \"Onest Variable\",sans-serif;cursor:pointer}.ds-nav:hover{background:#e5eaf3}.ds-nav:active{transform:scale(.98)}.ds-nav:focus-visible{outline:3px solid #1759e8;outline-offset:5px}"
    },
    {
      "name": "Cabinet expiry notice",
      "kind": "custom",
      "description": "Inline warning within the personal cabinet; date and conditions come from real data.",
      "html": "<section class=\"ds-expiry\" role=\"status\"><h3>Срок доступа скоро закончится</h3><p>Точная дата и оставшийся срок отображаются здесь.</p><a href=\"#renewal\">Как продлить</a></section>",
      "css": ".ds-expiry{padding:22px 24px;border-radius:12px;background:#fff0d8;color:#765010;font:12px/1.75 \"Onest Variable\",sans-serif}.ds-expiry h3{font-size:15px;line-height:1.4;margin:0}.ds-expiry p{margin:7px 0}.ds-expiry a{color:inherit;text-underline-offset:4px}.ds-expiry a:hover{text-decoration-thickness:2px}.ds-expiry a:focus-visible{outline:3px solid #1759e8;outline-offset:5px}.ds-expiry a:active{opacity:.8}"
    },
    {
      "name": "Password entry",
      "kind": "input",
      "description": "Masked password field with an accessible visibility control.",
      "html": "<label class=\"ds-password-label\">Пароль<span class=\"ds-password\"><input type=\"password\" autocomplete=\"current-password\" placeholder=\"Ваш пароль\"/><button type=\"button\" aria-label=\"Показать пароль\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><path d=\"M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></button></span></label>",
      "css": ".ds-password-label{display:grid;gap:9px;font:13px \"Onest Variable\",sans-serif;color:var(--text,#18202e)}.ds-password{position:relative;display:block}.ds-password input{box-sizing:border-box;width:100%;padding:14px 58px 14px 16px;border:1px solid var(--line,#dce0e8);border-radius:12px;background:var(--bg,#f5f6f8);color:var(--text,#18202e);font:14px \"Onest Variable\",sans-serif}.ds-password input::placeholder{color:var(--muted,#626b7c)}.ds-password button{position:absolute;inset:5px 5px 5px auto;display:grid;place-items:center;min-width:40px;border:0;border-radius:50%;background:transparent;color:var(--muted,#626b7c);cursor:pointer}.ds-password button:hover{background:#e2eafa;color:var(--accent,#1759e8)}.ds-password button:active{scale:.96}.ds-password input:focus-visible,.ds-password button:focus-visible{outline:3px solid var(--accent,#1759e8);outline-offset:4px}"
    }
  ],
  "narrative": {
    "northStar": "Живая линия / Living line",
    "overview": "A mineral white personal VPN interface with a cobalt route signature and self-hosted Cyrillic Onest. Public setup is expressive; administration remains calm and functional.",
    "keyCharacteristics": [
      "One dimensional looping route",
      "Light surfaces and cobalt actions",
      "Working subscription form in the hero",
      "Motion respects reduced-motion preferences"
    ],
    "rules": [
      {
        "name": "Useful color",
        "body": "Accent identifies action, focus, selection or measured traffic.",
        "section": "colors"
      },
      {
        "name": "One authored motion",
        "body": "The route owns expressive movement; routine tasks remain quick.",
        "section": "components"
      }
    ],
    "dos": [
      "Preserve real data and existing handlers.",
      "Keep phone overflow local.",
      "Provide labelled state and visible focus.",
      "Keep cabinet warnings inline and truthful; personal links are access credentials.",
      "Place self-service password changes in the inline Security section with current-password verification and clear session consequences."
    ],
    "donts": [
      "Do not restore the superseded Navigator comp.",
      "Do not invent ad-free or universal whitelist-bypass guarantees."
    ]
  }
}